{
  "compilerOptions": {
    //Changed target from es5 to es2015
    "target": "es2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "baseUrl": "src",
    "paths": {
      "@almLib/*": ["almLib/*"],
      "@components/*": ["almLib/components/*"],
      "@hooks/*": ["almLib/hooks/*"],
      "@utils/*": ["almLib/utils/*"],
      "@models/*": ["almLib/models/*"],
      "@almStore/*": ["almLib/store/*"],
      "@contextProviders/*": ["almLib/contextProviders/*"],
      "@common/*": ["almLib/common/*"],
      "@styles/*": ["almLib/styles/*"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "**/test-plans/**",
    "node_modules"
  ]
}
